    {
      description = m%%"
Local demo pipeline exercising import, ffmpeg, rsgain, and media-tagger
"%%,
      impure = false,
      name = "mediapm.media.demo.local.dQw4w9WgXcQ",
      steps = [
        {
          id = "step-0-0-import-video_untagged-to-video_untagged",
          inputs = {
            hash = "blake3:1f88e0efabb673588e0fb93bc882bca077eb4e8ecb1f77c3240b630ede2312ac",
            kind = "cas_hash",
          },
          max_retries = 0,
          outputs = {
            video_untagged = {
              capture = "stdout",
              name = "video_untagged",
            },
          },
          tool = "import",
        },
        {
          depends_on = [
            "step-0-0-import-video_untagged-to-video_untagged",
          ],
          id = "step-1-ffmpeg",
          inputs = {
            container = "mp4",
            input_content_0 = "${step_output.step-0-0-import-video_untagged-to-video_untagged.video_untagged}",
            output_path_0 = "output-0.m4a",
            vn = "true",
          },
          max_retries = 0,
          outputs = {
            primary = {
              capture = "file_regex:^output-0(?:[.][^/\\\\]+)?$",
              name = "primary",
            },
          },
          tool = "ffmpeg",
        },
        {
          depends_on = [
            "step-1-ffmpeg",
          ],
          id = "step-2-0-rsgain-audio-to-audio",
          inputs = {
            input_content = "${step_output.step-1-ffmpeg.primary}",
            input_extension = "m4a",
          },
          max_retries = 0,
          outputs = {
            output_content = {
              capture = "file_regex:^input[.](?:flac|ogg|oga|spx|opus|mp2|mp3|mp4|m4a|wma|wv|ape|wav|aiff|aif|snd|tak)$",
              name = "output_content",
            },
          },
          tool = "rsgain",
        },
        {
          depends_on = [
            "step-2-0-rsgain-audio-to-audio",
          ],
          id = "step-3-0-media-tagger-audio-to-audio-metadata",
          inputs = {
            ffmpeg_bin = "ffmpeg",
            input_content = "${step_output.step-2-0-rsgain-audio-to-audio.output_content}",
            leading_args = "[]",
            recording_mbid = "8f3471b5-7e6a-48da-86a9-c1c07a0f47ae",
            release_mbid = "",
            trailing_args = "[]",
            write_all_images = "false",
          },
          max_retries = 0,
          outputs = {
            content = {
              capture = "file:metadata/output.ffmeta",
              name = "content",
              save = "full",
            },
          },
          tool = "media-tagger",
        },
        {
          depends_on = [
            "step-2-0-rsgain-audio-to-audio",
            "step-3-0-media-tagger-audio-to-audio-metadata",
          ],
          id = "step-3-0-media-tagger-audio-to-audio-apply",
          inputs = {
            codec_copy = "true",
            ffmetadata_content = "${step_output.step-3-0-media-tagger-audio-to-audio-metadata.content}",
            input_content_0 = "${step_output.step-2-0-rsgain-audio-to-audio.output_content}",
            leading_args = "[]",
            map_metadata = "1",
            output_path_0 = "output-0.mkv",
            trailing_args = "[]",
            vn = "false",
          },
          max_retries = 0,
          outputs = {
            primary = {
              capture = "file_regex:^output-0(?:[.][^/\\\\]+)?$",
              name = "primary",
            },
          },
          tool = "ffmpeg",
        },
      ],
    },
